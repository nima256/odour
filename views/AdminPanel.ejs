<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#f7f5f0">
  <title>پنل مدیریت اودر</title>
  <link rel="preload" href="/admin/fonts/vazirmatn/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/admin-assets/admin.css?v=<%= assetVersion %>">
</head>
<body class="oa">
  <%- include('./partials/admin/icons') %>
  <a class="sr-only" href="#oa-content">پرش به محتوا</a>
  <div class="oa-shell">
    <aside class="oa-sidebar" id="oa-sidebar" aria-label="منوی مدیریت">
      <div class="oa-brand">
        <div class="oa-brand__mark" aria-hidden="true">OD</div>
        <div>
          <div class="oa-brand__name">ODOUR</div>
          <div class="oa-brand__sub">پنل مدیریت فروشگاه</div>
        </div>
      </div>
      <nav class="oa-nav" id="oa-nav"></nav>
      <div class="oa-sidebar__foot">
        <div class="oa-avatar" aria-hidden="true"><%= (adminBoot.admin.fullName || 'A').trim().charAt(0) %></div>
        <div class="oa-sidebar__who">
          <b><%= adminBoot.admin.fullName %></b>
          <span><%= adminBoot.admin.role === 'super_admin' ? 'مدیر ارشد' : 'مدیر' %></span>
        </div>
        <button class="oa-btn oa-btn--ghost oa-btn--icon oa-btn--sm" type="button" id="oa-logout" title="خروج" aria-label="خروج از حساب">
          <svg class="oa-icon"><use href="#i-logout"/></svg>
        </button>
      </div>
    </aside>
    <div class="oa-scrim" id="oa-scrim"></div>

    <div class="oa-main">
      <header class="oa-topbar" id="oa-topbar">
        <button class="oa-btn oa-btn--ghost oa-btn--icon oa-menu-btn" type="button" id="oa-menu" aria-label="باز کردن منو" aria-controls="oa-sidebar" aria-expanded="false">
          <svg class="oa-icon"><use href="#i-menu"/></svg>
        </button>
        <div>
          <div class="oa-topbar__crumb" id="oa-crumb">اودر</div>
          <div class="oa-topbar__title" id="oa-title">داشبورد</div>
        </div>
        <div class="oa-topbar__spacer"></div>
        <a class="oa-btn oa-btn--ghost oa-btn--sm" href="/" target="_blank" rel="noopener">
          <svg class="oa-icon oa-icon--sm"><use href="#i-external"/></svg><span class="oa-hide-sm">مشاهده فروشگاه</span>
        </a>
        <div class="oa-dropdown" id="oa-notify">
          <button class="oa-btn oa-btn--ghost oa-btn--icon oa-bell" type="button" id="oa-bell" aria-haspopup="true" aria-expanded="false" aria-label="اعلان‌ها">
            <svg class="oa-icon"><use href="#i-bell"/></svg>
            <span class="oa-bell__dot" id="oa-bell-dot" hidden></span>
          </button>
          <div class="oa-popover" id="oa-notify-panel" role="dialog" aria-label="اعلان‌ها"></div>
        </div>
      </header>
      <main class="oa-content" id="oa-content" tabindex="-1" aria-live="polite"></main>
    </div>
  </div>
  <div class="oa-toasts" id="oa-toasts" role="status" aria-live="polite"></div>

  <script id="oa-boot" type="application/json"><%- JSON.stringify(adminBoot).replace(/</g, '\\u003c') %></script>
  <script src="/admin-assets/js/core.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/charts.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/dashboard.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/analytics.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/orders.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/products.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/inventory.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/customers.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/catalog.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/marketing.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/content.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/team.js?v=<%= assetVersion %>" defer></script>
  <script src="/admin-assets/js/boot.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
